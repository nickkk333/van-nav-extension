{
  "name": "Van Nav 管理扩展",
  "description": "为 Van Nav 导航站提供一键收录当前页面、内外网地址自动切换，以及设置浏览器启动页与新标签页的管理工具",
  "version": "1.3.0",
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "van-nav-extension@nickkk333",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "Van Nav 管理扩展",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo.png",
      "32": "images/logo.png",
      "48": "images/logo.png",
      "128": "images/logo.png"
    }
  },
  "icons": {
    "16": "images/logo.png",
    "32": "images/logo.png",
    "48": "images/logo.png",
    "128": "images/logo.png"
  }
}