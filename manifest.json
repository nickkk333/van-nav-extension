{
  "name": "VanNav 管理扩展",
  "description": "为 VanNav 导航站提供一键收录当前页面、快捷访问前台/后台的管理工具",
  "version": "1.1.0",
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "VanNav 管理扩展",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo.png",
      "32": "images/logo.png",
      "48": "images/logo.png",
      "128": "images/logo.png"
    }
  },
  "icons": {
    "16": "images/logo.png",
    "32": "images/logo.png",
    "48": "images/logo.png",
    "128": "images/logo.png"
  }
}