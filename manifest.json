{
  "name": "Van Nav 管理扩展",
  "description": "为 Van Nav 导航站提供一键收录当前页面、快捷访问前台/后台的管理工具",
  "version": "1.1.1",
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "van-nav-extension@nickkk333",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Van Nav 管理扩展",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo.png",
      "32": "images/logo.png",
      "48": "images/logo.png",
      "128": "images/logo.png"
    }
  },
  "icons": {
    "16": "images/logo.png",
    "32": "images/logo.png",
    "48": "images/logo.png",
    "128": "images/logo.png"
  }
}